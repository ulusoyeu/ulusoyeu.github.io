---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { getPoems, getPhotos, getMusic } from '../../../lib/content';
import { themePaths, href, displayDate } from '../../../lib/routes';
import stage from '../../../content/images/stage.jpg';

export const getStaticPaths = () => themePaths();

const theme = Astro.params.theme;
const [poems, photos, music] = await Promise.all([getPoems(), getPhotos(), getMusic()]);
---

<Base title="Personal" description="Poetry, photography and music.">
  <article class="personal">
    <header class="page-header">
      <h1>Personal</h1>
    </header>

    <!-- Photo on the right; the intro wraps around it and the sections below start under it. Size and position: see "Personal page photo" in public/styles/latex.css. -->
    <figure class="side-photo">
      <Image
        src={stage}
        alt="Emre playing electric guitar on stage under red lights, with the band behind"
        width={1200}
        widths={[480, 800, 1200]}
        sizes="(min-width: 760px) 400px, 100vw"
      />
      <figcaption>On stage with the beautiful and most talented Cosmos Zero and Zao Yuan.</figcaption>
    </figure>

    <div class="intro">
      <p>I ocassionally take stage to play funky or wacky music with various projects, and write sloppy poetry in my free time. Most of the poetry is in my mother tongue, Turkish.
      Also recently getting into photography.</p>
    </div>

<!-- 
    <section aria-labelledby="photography">
      <h2 id="photography">Photography</h2>
      <div class="gallery">
        {
          photos.map(({ data }) => (
            <figure>
              <a href={data.image.src}>
                <Image src={data.image} alt={data.alt} widths={[400, 800]} sizes="(min-width: 760px) 360px, 100vw" />
              </a>
              {data.caption && <figcaption>{data.caption}</figcaption>}
            </figure>
          ))
        }
      </div>
    </section>

    <hr class="fade" />
-->

    <section aria-labelledby="poetry">
      <h2 id="poetry">Şiirler</h2>
      <ul class="post-list">
        {
          poems.map((poem) => (
            <li>
              <time datetime={displayDate(poem.data).iso}>{displayDate(poem.data).label}</time>
              <a href={href(theme, `/personal/poetry/${poem.id}/`)}>{poem.data.title}</a>
            </li>
          ))
        }
      </ul>
    </section>

<!-- 
    <hr class="fade" />

    <section aria-labelledby="music">
      <h2 id="music">Music</h2>
      <ul class="music-list">
        {
          music.map(({ data }) => (
            <li>
              <h3>{data.link ? <a href={data.link}>{data.title}</a> : data.title}</h3>
              <p class="meta">
                <time datetime={displayDate(data).iso}>{displayDate(data).label}</time>
                {data.description && <> · {data.description}</>}
              </p>
              {data.audio && <audio controls preload="none" src={data.audio} />}
            </li>
          ))
        }
      </ul>
    </section>
-->
  </article>
</Base>
