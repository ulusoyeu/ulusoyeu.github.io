---
// Shared page shell: <head> meta (SEO, Open Graph), navigation and footer.
// The look comes entirely from the theme stylesheet in public/styles/.
import 'katex/dist/katex.min.css';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { SITE, NAV, THEME } from '../config';
import { href } from '../lib/routes';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
}

const { title, description = SITE.description, type = 'website', published } = Astro.props;
const theme = Astro.params.theme;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const about = (await getEntry('about', 'about'))!;
const ogImage = await getImage({ src: about.data.photo, width: 600, format: 'jpg' });
const current = Astro.url.pathname.replace(href(theme, ''), '') || '/';
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="stylesheet" href="/styles/base.css" />
    <link rel="stylesheet" href={`/styles/${theme ?? THEME}.css`} />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-title" href={href(theme, '/')}>{SITE.title}</a>
      <nav aria-label="Main">
        <ul>
          {
            NAV.map(({ label, path }) => (
              <li>
                <a
                  href={href(theme, path)}
                  aria-current={
                    path === '/' ? (current === '/' ? 'page' : undefined) : current.startsWith(path) ? 'page' : undefined
                  }
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {about.data.name}</p>
    </footer>
  </body>
</html>
